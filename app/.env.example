# Database - Aiven PostgreSQL
# Lấy connection string từ Aiven Console > PostgreSQL service > Connection information
# Thêm ?sslmode=require nếu Aiven yêu cầu SSL
DATABASE_URL="postgresql://avnadmin:your-password@your-aiven-host.aivencloud.com:12345/defaultdb?sslmode=require"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"

# Security
# Tạo secret mạnh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN_SECONDS="604800"
AUTH_COOKIE_NAME="auth-token"

# SMTP (Gửi email xác minh)
# Gmail example:
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
#   SMTP_USER="your-email@gmail.com"
#   SMTP_PASS="your-app-password"
#   SMTP_FROM="your-email@gmail.com"
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
