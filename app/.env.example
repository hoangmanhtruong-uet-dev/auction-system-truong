# Database - MySQL (source of truth for this repository)
DATABASE_URL="mysql://autobid:local-only-password@localhost:3306/autobid"
# Dedicated disposable services only; database name must end in `_test`.
TEST_DATABASE_URL="mysql://integration_user:integration_password@localhost:3307/auction_system_test"
TEST_REDIS_URL="redis://localhost:6380/15"
# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ORIGIN="http://localhost:3000"
APP_ENV="development"

# Security
# Táº¡o secret máº¡nh báº±ng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-at-least-32-random-characters"
JWT_EXPIRES_IN_SECONDS="28800"
SESSION_ABSOLUTE_TIMEOUT_SECONDS="28800"
SESSION_IDLE_TIMEOUT_SECONDS="1800"
# Explicitly choose none, vercel, cloudflare, or nginx. Proxy headers are ignored when none.
TRUSTED_PROXY_PROVIDER="none"
ADMIN_PROFILE_ID="replace-with-admin-profile-id"
CRON_SECRET="replace-me-with-at-least-32-random-characters"

# Development/test bootstrap only. Never set ALLOW_DEMO_SEED=true in production.
# ALLOW_DEMO_SEED="true"
# SEED_ADMIN_EMAIL="bootstrap@example.test"
# SEED_ADMIN_PASSWORD="generate-a-unique-temporary-password"
# DEMO_SEED_PASSWORD="generate-a-unique-demo-password"

# Redis / BullMQ
REDIS_URL="redis://:local-only-password@localhost:6379/0"
REDIS_TLS_ENABLED="false"
REDIS_MAX_RECONNECT_ATTEMPTS="10"
# Production must remain closed; open is permitted only for explicit non-production development.
RATE_LIMIT_FAILURE_MODE="closed"
QUEUE_PREFIX="autobid"

# Runtime / health / workers
APP_VERSION="development"
HEALTH_CHECK_TIMEOUT_MS="2000"
REQUIRE_WORKER_HEARTBEAT="false"
REQUIRED_WORKER_NAME="workers"
WORKER_NAME="workers"
WORKER_HEARTBEAT_INTERVAL_MS="10000"
WORKER_HEARTBEAT_TTL_SECONDS="30"
WORKER_SHUTDOWN_TIMEOUT_MS="30000"
OUTBOX_BATCH_SIZE="20"
OUTBOX_POLL_INTERVAL_MS="1000"
OUTBOX_LOCK_TIMEOUT_MS="30000"
OUTBOX_MAX_ATTEMPTS="8"
OUTBOX_BASE_BACKOFF_MS="1000"
OUTBOX_PUBLISH_TIMEOUT_MS="5000"

# Financial safety: keep both false until the dedicated payment/ledger review passes.
PLATFORM_FEE_PERCENT="5"
FINANCIAL_OPERATIONS_ENABLED="false"
REAL_MONEY_PAYMENTS_ENABLED="false"

# Optional production security-alert receiver. Never commit a real endpoint or bearer.
# SECURITY_ALERT_WEBHOOK_URL="https://alerts.example.invalid/security-events"
# SECURITY_ALERT_WEBHOOK_BEARER="replace-in-hosting-secret-store"
SECURITY_ALERT_COOLDOWN_MS="60000"
SECURITY_ALERT_TIMEOUT_MS="2000"

# SMTP (Gá»­i email xĂ¡c minh)
# Gmail example:
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
#   SMTP_USER="your-email@gmail.com"
#   SMTP_PASS="your-app-password"
#   SMTP_FROM="your-email@gmail.com"
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
