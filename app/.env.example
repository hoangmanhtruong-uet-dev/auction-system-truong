# Database - MySQL
# Local Docker example: mysql://autobid:autobid@localhost:3306/autobid
DATABASE_URL="mysql://autobid:autobid@localhost:3306/autobid"
# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"

# Security
# Táº¡o secret máº¡nh báº±ng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN_SECONDS="604800"
AUTH_COOKIE_NAME="auth-token"
ADMIN_EMAIL="admin@autobid.vn"

