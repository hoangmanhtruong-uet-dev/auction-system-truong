{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/__tests__/*.test.mjs src/__tests__/infrastructure.test.ts src/__tests__/security.test.ts",
    "test:security": "tsx --test src/__tests__/security.test.ts",
    "test:integration": "node scripts/verify-integration-env.mjs && prisma migrate deploy --schema=prisma/schema.prisma && tsx --test --test-concurrency=1 src/__tests__/*.integration.test.ts",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:security && npm run test:integration && npm run build",
    "build": "prisma generate --schema=prisma/schema.prisma && next build",
    "start": "next start",
    "start:web": "next start",
    "start:worker": "tsx src/workers/index.ts",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@tailwindcss/postcss": "4.3.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "prisma": "^6.1.0",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion@1.1.15": "1.1.16",
    "next@16.2.9": {
      "postcss": "8.5.10"
    }
  }
}
