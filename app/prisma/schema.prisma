generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SELLER
  SUPPORT
  MODERATOR
  FINANCE
  ADMIN
  SUPER_ADMIN

  @@map("user_role")
}

enum AuctionStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("auction_status")
}

enum BidStatus {
  ACTIVE
  WON
  LOST
  CANCELLED

  @@map("bid_status")
}

enum NotificationType {
  AUCTION_CREATED
  AUCTION_ACTIVATED
  AUCTION_ENDING_SOON
  AUCTION_ENDED
  BID_PLACED
  BID_OUTBID
  BID_WON
  BID_LOST
  AUCTION_PAID
  SYSTEM

  @@map("notification_type")
}

enum AuditAction {
  PROFILE_CREATED
  PROFILE_UPDATED
  AUCTION_CREATED
  AUCTION_ACTIVATED
  AUCTION_CANCELLED
  AUCTION_COMPLETED
  BID_PLACED
  BID_CANCELLED
  WATCHLIST_ADDED
  WATCHLIST_REMOVED
  NOTIFICATION_CREATED
  ADMIN_ACTION

  @@map("audit_action")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BID_FREEZE
  BID_UNFREEZE
  SETTLEMENT_DEBIT
  PLATFORM_FEE
  SELLER_PAYOUT
  REFUND
  PENALTY
  ADMIN_ADJUSTMENT

  @@map("transaction_type")
}

enum FreezeStatus {
  ACTIVE
  RELEASED
  SETTLED
  FORFEITED

  @@map("freeze_status")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  DEAD_LETTER

  @@map("outbox_status")
}

model Profile {
  id             String    @id @default(uuid()) @db.Char(36)
  email          String    @unique @db.VarChar(255)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  emailVerified  Boolean   @default(true) @map("email_verified")
  fullName       String    @map("full_name") @db.VarChar(255)
  phone          String?   @db.VarChar(20)
  role           UserRole  @default(USER)
  avatarUrl      String?   @map("avatar_url") @db.Text
  sessionVersion Int       @default(0) @map("session_version")
  failedLoginCount Int      @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.DateTime(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.DateTime(6)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(6)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(6)
  address        String?   @db.Text
  city           String?   @db.VarChar(100)
  gender         String?   @db.VarChar(10)
  birthday       DateTime? @db.Date
  bio            String?   @db.Text

  auctionsAsSeller        Auction[]                @relation("AuctionSeller")
  auctionsAsWinner        Auction[]                @relation("AuctionWinner")
  bids                    Bid[]
  watchlistItems          Watchlist[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  userPreference          UserPreference?
  emailVerificationTokens EmailVerificationToken[]
  authSessions            AuthSession[]
  wallet                  Wallet?

  @@index([email], map: "idx_profiles_email")
  @@index([role], map: "idx_profiles_role")
  @@map("profiles")
}

model AuthSession {
  id             String    @id @default(uuid()) @db.Char(36)
  profileId      String    @map("profile_id") @db.Char(36)
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  sessionVersion Int       @map("session_version")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.DateTime(6)
  expiresAt      DateTime  @map("expires_at") @db.DateTime(6)
  revokedAt      DateTime? @map("revoked_at") @db.DateTime(6)
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  userAgent      String?   @map("user_agent") @db.VarChar(512)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, revokedAt, expiresAt], map: "idx_auth_sessions_profile_status")
  @@index([lastSeenAt], map: "idx_auth_sessions_last_seen")
  @@map("auth_sessions")
}

model Wallet {
  id          String   @id @default(uuid()) @db.Char(36)
  profileId   String   @unique @map("profile_id") @db.Char(36)
  balance     BigInt   @default(0)
  totalFrozen BigInt   @default(0) @map("total_frozen")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  profile      Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  freezes      BalanceFreeze[]

  @@map("wallets")
}

model WalletTransaction {
  id            String          @id @default(uuid()) @db.Char(36)
  walletId      String          @map("wallet_id") @db.Char(36)
  type          TransactionType
  amount        BigInt
  balanceBefore BigInt          @map("balance_before")
  balanceAfter  BigInt          @map("balance_after")
  referenceType String?         @map("reference_type") @db.VarChar(50)
  referenceId   String?         @map("reference_id") @db.Char(36)
  description   String          @db.Text
  status        String          @default("COMPLETED") @db.VarChar(20)
  createdAt     DateTime        @default(now()) @map("created_at") @db.DateTime(6)

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt], map: "idx_wallet_tx_wallet_id_created_at")
  @@index([referenceType, referenceId], map: "idx_wallet_tx_reference")
  @@index([type], map: "idx_wallet_tx_type")
  @@index([createdAt], map: "idx_wallet_tx_created_at")
  @@map("wallet_transactions")
}

model BalanceFreeze {
  id         String       @id @default(uuid()) @db.Char(36)
  walletId   String       @map("wallet_id") @db.Char(36)
  auctionId  String       @map("auction_id") @db.Char(36)
  bidId      String?      @map("bid_id") @db.Char(36)
  amount     BigInt
  status     FreezeStatus @default(ACTIVE)
  reason     String?      @db.VarChar(100)
  createdAt  DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.DateTime(6)
  releasedAt DateTime?    @map("released_at") @db.DateTime(6)

  wallet  Wallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bid     Bid?    @relation(fields: [bidId], references: [id], onDelete: SetNull)

  @@index([walletId, status], map: "idx_balance_freeze_wallet_id_status")
  @@index([auctionId, status], map: "idx_balance_freeze_auction_id_status")
  @@index([walletId, auctionId, status], map: "idx_balance_freeze_wallet_auction_status")
  @@map("balance_freezes")
}

model Auction {
  id                    String        @id @default(uuid()) @db.Char(36)
  title                 String        @db.VarChar(255)
  description           String        @db.Text
  startPrice            BigInt        @map("start_price")
  currentPrice          BigInt        @default(0) @map("current_price")
  bidStep               BigInt        @default(10000) @map("bid_step")
  category              String?       @db.VarChar(100)
  condition             String?       @db.VarChar(100)
  durationMinutes       Int           @default(15) @map("duration_minutes")
  autoExtensionEnabled  Boolean       @default(true) @map("auto_extension_enabled")
  maxExtensions         Int           @default(3) @map("max_extensions")
  currentExtensionCount Int           @default(0) @map("current_extension_count")
  status                AuctionStatus @default(PENDING)
  sellerId              String        @map("seller_id") @db.Char(36)
  winnerId              String?       @map("winner_id") @db.Char(36)
  startsAt              DateTime?     @map("starts_at") @db.DateTime(6)
  endsAt                DateTime?     @map("ends_at") @db.DateTime(6)
  paidAt                DateTime?     @map("paid_at") @db.DateTime(6)
  paidById              String?       @map("paid_by_id") @db.Char(36)
  payByDeadline         DateTime?     @map("pay_by_deadline") @db.DateTime(6)
  canceledAt            DateTime?     @map("canceled_at") @db.DateTime(6)
  canceledById          String?       @map("canceled_by_id") @db.Char(36)
  cancelReason          String?       @map("cancel_reason") @db.Text
  finishedAt            DateTime?     @map("finished_at") @db.DateTime(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.DateTime(6)
  deletedAt             DateTime?     @map("deleted_at") @db.DateTime(6)

  seller         Profile         @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  winner         Profile?        @relation("AuctionWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  images         AuctionImage[]
  bids           Bid[]
  watchlistItems Watchlist[]
  notifications  Notification[]
  balanceFreezes BalanceFreeze[]

  @@index([status, endsAt], map: "idx_auctions_status_ends_at")
  @@index([status, startsAt, endsAt], map: "idx_auctions_status_starts_at_ends_at")
  @@index([sellerId, status], map: "idx_auctions_seller_id_status")
  @@index([winnerId], map: "idx_auctions_winner_id")
  @@map("auctions")
}

model AuctionImage {
  id        String   @id @default(uuid()) @db.Char(36)
  auctionId String   @map("auction_id") @db.Char(36)
  url       String   @db.Text
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId, sortOrder], map: "idx_auction_images_auction_id_sort_order")
  @@map("auction_images")
}

model Bid {
  id              String    @id @default(uuid()) @db.Char(36)
  auctionId       String    @map("auction_id") @db.Char(36)
  bidderId        String    @map("bidder_id") @db.Char(36)
  amount          BigInt
  isAutoBid       Boolean   @default(false) @map("is_auto_bid")
  autoBidMaxPrice BigInt?   @map("auto_bid_max_price")
  idempotencyKey  String?   @unique(map: "uq_bids_idempotency_key") @map("idempotency_key") @db.VarChar(64)
  status          BidStatus @default(ACTIVE)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(6)
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(6)

  auction        Auction         @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder         Profile         @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  balanceFreezes BalanceFreeze[]

  @@index([auctionId, amount], map: "idx_bids_auction_id_amount")
  @@index([auctionId, status, amount], map: "idx_bids_auction_id_status_amount")
  @@index([bidderId, createdAt], map: "idx_bids_bidder_id_created_at")
  @@index([status], map: "idx_bids_status")
  @@map("bids")
}

model Watchlist {
  id        String   @id @default(uuid()) @db.Char(36)
  profileId String   @map("profile_id") @db.Char(36)
  auctionId String   @map("auction_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([profileId, auctionId], map: "uq_watchlist_profile_id_auction_id")
  @@index([auctionId], map: "idx_watchlist_auction_id")
  @@map("watchlist")
}

model Notification {
  id             String           @id @default(uuid()) @db.Char(36)
  idempotencyKey String?          @unique(map: "uq_notifications_idempotency_key") @map("idempotency_key") @db.VarChar(191)
  profileId      String           @map("profile_id") @db.Char(36)
  auctionId      String?          @map("auction_id") @db.Char(36)
  type           NotificationType
  title          String           @db.VarChar(255)
  message        String           @db.Text
  metadata       Json?
  readAt         DateTime?        @map("read_at") @db.DateTime(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(6)

  profile Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  auction Auction? @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([profileId, readAt, createdAt], map: "idx_notifications_profile_id_read_at_created_at")
  @@index([auctionId], map: "idx_notifications_auction_id")
  @@index([type], map: "idx_notifications_type")
  @@map("notifications")
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Char(36)
  profileId    String?     @map("profile_id") @db.Char(36)
  action       AuditAction
  resourceType String      @map("resource_type") @db.VarChar(100)
  resourceId   String      @map("resource_id") @db.Char(36)
  oldValues    Json?       @map("old_values")
  newValues    Json?       @map("new_values")
  ipAddress    String?     @map("ip_address") @db.VarChar(45)
  userAgent    String?     @map("user_agent") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.DateTime(6)

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([profileId], map: "idx_audit_logs_profile_id")
  @@index([resourceType, resourceId], map: "idx_audit_logs_resource_type_resource_id")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@index([action], map: "idx_audit_logs_action")
  @@map("audit_logs")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Char(36)
  profileId String    @map("profile_id") @db.Char(36)
  email     String    @db.VarChar(255)
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.DateTime(6)
  usedAt    DateTime? @map("used_at") @db.DateTime(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, usedAt, expiresAt], map: "idx_email_verification_tokens_profile_id_used_at_expires_at")
  @@index([email], map: "idx_email_verification_tokens_email")
  @@map("email_verification_tokens")
}

model UserPreference {
  id                       String   @id @default(uuid()) @db.Char(36)
  profileId                String   @map("profile_id") @db.Char(36)
  receiveEmailMarketing    Boolean  @default(true) @map("receive_email_marketing")
  receiveEmailAuction      Boolean  @default(true) @map("receive_email_auction")
  receiveEmailNotification Boolean  @default(true) @map("receive_email_notification")
  darkMode                 Boolean  @default(false) @map("dark_mode")
  locale                   String   @default("vi-VN") @db.VarChar(10)
  createdAt                DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.DateTime(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId], map: "uq_user_preferences_profile_id")
  @@index([profileId], map: "idx_user_preferences_profile_id")
  @@map("user_preferences")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Char(36)
  eventType      String       @map("event_type") @db.VarChar(100)
  aggregateType  String       @map("aggregate_type") @db.VarChar(100)
  aggregateId    String       @map("aggregate_id") @db.Char(36)
  idempotencyKey String       @unique(map: "uq_outbox_events_idempotency_key") @map("idempotency_key") @db.VarChar(191)
  payload        Json
  status         OutboxStatus @default(PENDING)
  attemptCount   Int          @default(0) @map("attempt_count")
  availableAt    DateTime     @default(now()) @map("available_at") @db.DateTime(6)
  lockedAt       DateTime?    @map("locked_at") @db.DateTime(6)
  lockedBy       String?      @map("locked_by") @db.VarChar(191)
  processedAt    DateTime?    @map("processed_at") @db.DateTime(6)
  lastError      String?      @map("last_error") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(6)

  @@index([status, availableAt], map: "idx_outbox_events_status_available_at")
  @@index([status, lockedAt], map: "idx_outbox_events_status_locked_at")
  @@index([aggregateType, aggregateId], map: "idx_outbox_events_aggregate")
  @@map("outbox_events")
}
